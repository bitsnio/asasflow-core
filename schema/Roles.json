
{
  "schema": {
    "title": "Create Role",
    "description": "Create a role for the current tenant.",
    "type": "object",
    "required": [
      "name"
    ],
    "properties": {
      "name": {
        "type": "string",
        "title": "Role Name",
        "description": "Enter a unique name for this role.",
        "minLength": 2,
        "maxLength": 125,
        "pattern": ".*\\S.*",
        "widget": {
          "formlyConfig": {
            "props": {
              "placeholder": "e.g. Branch Manager",
              "required": true
            }
          }
        }
      },
      "description": {
        "type": [
          "string",
          "null"
        ],
        "title": "Description",
        "description": "Optional details about the role.",
        "maxLength": 1000,
        "widget": {
          "formlyConfig": {
            "type": "textarea",
            "props": {
              "placeholder": "Describe the role's responsibilities",
              "rows": 3
            }
          }
        }
      },
      "is_active": {
        "type": "boolean",
        "title": "Active",
        "default": true
      }
    }
  },
  "model": {
    "name": "",
    "description": null,
    "is_active": true
  }
}
